cabal-version:      2.4
name:               norrs-taffybar
version:            0.1.0.0
homepage:           https://github.com/norrs/dotfiles/tree/master/dotfiles/config/taffybar
license:            BSD3
author:             Roy Sindre Norangshol
maintainer:         roy.sindre@norangshol.no
copyright:          Roy Sindre Norangshol
category:           Web

executable norrs-taffybar
    main-is:          taffybar.hs
    ghc-options:      -threaded -rtsopts -with-rtsopts=-N
    ghc-prof-options: -fprof-auto
    pkgconfig-depends: gtk+-3.0
    -- -Wall -Werror -Wno-incomplete-record-updates

    -- Modules included in this executable, other than Main.
    -- other-modules:

    -- LANGUAGE extensions used by modules in this package.
    -- other-extensions:
    build-depends:    base
                    , gi-gtk-hs
                    , haskell-gi-base
                    , gi-gdk
                    , taffybar
                    , text
                    , process
                    , transformers
    hs-source-dirs:   .
    default-language: Haskell2010

source-repository head
  type:     git
  location: https://github.com/norrs/dotfiles
