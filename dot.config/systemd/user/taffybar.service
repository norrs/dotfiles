[Unit]
Description=taffybar
Wants=status-notifier-watcher.service
After=status-notifier-watcher.service

[Service]
Type=simple
WorkingDirectory=/usr/share/pixmaps
Environment=PATH=%h/.local/bin:%h/.nix-profile/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env taffybar
ExecStop=/usr/bin/pkill -x taffybar

[Install]
WantedBy=wm.target
