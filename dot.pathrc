#!/bin/bash

directories=(
  "$HOME/.local/share/rtx/shims"
  "/opt/homebrew/bin"
  "$HOME/.cabal/bin"
  "$HOME/bin"
  "$HOME/.opt/kubectx"
  "${KREW_ROOT:-$HOME/.krew}/bin"
  "/opt/pycharm/bin"
  "/opt/java/bin"
  "/opt/node/bin"
  "/opt/arcanist/bin"
  "/opt/rkt"
  "/opt/rkt-spec/bin"
  "/opt/deb2aci/bin"
  "/opt/ripgrep"
  "$HOME/.cargo/bin"
  "/home/linuxbrew/.linuxbrew/bin"
  "/opt/docker2aci/bin"
  "$HOME/.local/bin"
  "/usr/local/kubebuilder/bin"
  "$HOME/go/bin"
  "$HOME/.gem/ruby/2.5.0/bin"
  "$HOME/.rbenv/bin"
  "/opt/homebrew/opt/libpq/bin"
  "/opt/homebrew/opt/llvm/bin"
  "$HOME/src/apache-tomcat-9.0.52/bin"
)

# Source work-specific directories if available (e.g., Cisco-specific paths)
# Try to find dotfiles-work relative to where this script is symlinked from
DOTFILES_DIR="$(dirname "$(readlink ~/.pathrc)")"
if [ -f "$DOTFILES_DIR/dotfiles-work/dot.pathrc-cisco" ]; then
  source "$DOTFILES_DIR/dotfiles-work/dot.pathrc-cisco"
  # Merge cisco_directories into directories array
  directories+=("${cisco_directories[@]}")
fi

# Additional SDK paths
if [ -f "$HOME/.local/opt/google-cloud-sdk/path.bash.inc" ]; then
  . "$HOME/.local/opt/google-cloud-sdk/path.bash.inc"
fi

if [ -f "$HOME/.local/opt/google-cloud-sdk/completion.bash.inc" ]; then
  . "$HOME/.local/opt/google-cloud-sdk/completion.bash.inc"
fi

if [ -f "$HOME/google-cloud-sdk/path.bash.inc" ]; then
  . "$HOME/google-cloud-sdk/path.bash.inc"
fi

if [ -f "$HOME/google-cloud-sdk/completion.bash.inc" ]; then
  . "$HOME/google-cloud-sdk/completion.bash.inc"
fi

# Android SDK path
if [[ "$OSTYPE" == "darwin"* ]]; then
  ANDROID_HOME="/Users/norrs/Library/Android/sdk"
else
  ANDROID_HOME="$HOME/.local/opt/android-sdk-linux/sdk"
fi
ANDROID_BIN="$ANDROID_HOME/tools:$ANDROID_HOME/platform-tools"

export CATALINA_HOME="$HOME/src/apache-tomcat-9.0.52"

# Maven path
M2_HOME="/opt/maven3"
M2="$M2_HOME/bin"

export M2_HOME="/opt/maven3"
export M2="$M2_HOME/bin"

# Include Android and Maven paths
directories+=("/opt/play" "$ANDROID_BIN" "$M2")

# Build the PATH variable
BUILT_PATH=""
for dir in "${directories[@]}"; do
  if [[ -d "$dir" ]]; then
    BUILT_PATH="$dir:$BUILT_PATH"
  fi
done

# Append existing PATH
BUILT_PATH="${BUILT_PATH}${PATH}"

# Export the built PATH
export PATH="$BUILT_PATH"

# Also echo for use by update-paths Makefile target
echo "$BUILT_PATH"
