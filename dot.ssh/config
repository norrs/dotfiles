# Include Colima SSH config if it exists (optional)
Include ~/.colima/ssh_config

# Include work-specific SSH config if it exists (optional)
Include ~/.ssh/config-cisco

# GitHub.com - Personal (default for all github.com access)
Host github.com github-personal github.com-personal
    HostName github.com
    User git
    # Will use "norrs - github - auth" key from 1Password

# Router rescue shell
Host 192.168.50.25
    Tag no-default-identity
    User root
    Port 4748
    IdentityAgent SSH_AUTH_SOCK
    IdentitiesOnly no

# On macOS, use 1Password as the default SSH agent when its socket exists.
Match exec "test \"$(uname)\" = Darwin && test -S \"$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock\""
    IdentityAgent ~/Library/Group\ Containers/2BUA8C4S2C.com.1password/t/agent.sock

# Default: pin the public key we ask the active agent to use.
Host *
    Tag norrs-github-auth

Match tagged norrs-github-auth !tagged no-default-identity !tagged work
    IdentityFile ~/.ssh/norrs-github-auth.pub
    IdentitiesOnly yes
