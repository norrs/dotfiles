#!/usr/bin/env bash
# kubeconfig-rancher - Select and export a rancher kubeconfig using fzf
#
# Usage:
#   eval "$(kubeconfig-rancher)"
#   or source it: source <(kubeconfig-rancher)

set -euo pipefail

# Find all kubeconfig files in ~/.rancher-* directories
# Exclude cli2.json files which are rancher CLI config, not kubeconfigs
find_kubeconfigs() {
    local configs=()
    for dir in ~/.rancher-*/; do
        if [[ -d "$dir" ]]; then
            while IFS= read -r -d '' file; do
                # Skip cli2.json files
                [[ "$(basename "$file")" == "cli2.json" ]] && continue
                configs+=("$file")
            done < <(find "$dir" -maxdepth 1 -type f -print0 2>/dev/null)
        fi
    done
    printf '%s\n' "${configs[@]}"
}

# Format kubeconfig path for display: rancher-instance:cluster-name
format_display() {
    local path="$1"
    local dir_name rancher_instance cluster_name
    dir_name=$(dirname "$path")
    rancher_instance=$(basename "$dir_name" | sed 's/^\.rancher-//')
    cluster_name=$(basename "$path")
    echo "${rancher_instance}:${cluster_name}"
}

# Main
main() {
    # Check for fzf
    if ! command -v fzf &>/dev/null; then
        echo "Error: fzf is required but not installed" >&2
        exit 1
    fi

    # Get all kubeconfigs
    mapfile -t kubeconfigs < <(find_kubeconfigs)

    if [[ ${#kubeconfigs[@]} -eq 0 ]]; then
        echo "No kubeconfigs found in ~/.rancher-* directories" >&2
        exit 1
    fi

    # Build display list with paths
    local display_list=()
    for config in "${kubeconfigs[@]}"; do
        display_list+=("$(format_display "$config")|$config")
    done

    # Use fzf to select
    local selected
    selected=$(printf '%s\n' "${display_list[@]}" | \
        fzf --delimiter='|' \
            --with-nth=1 \
            --preview='cat {2}' \
            --preview-window=right:50%:wrap \
            --header='Select kubeconfig (Ctrl-C to cancel)' \
            --prompt='kubeconfig> ') || exit 0

    # Extract the path from selection
    local kubeconfig_path
    kubeconfig_path=$(echo "$selected" | cut -d'|' -f2)

    # Output export command for eval
    echo "export KUBECONFIG=\"$kubeconfig_path\""
}

main "$@"
