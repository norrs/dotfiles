#!/usr/bin/env python3
"""A small, dependency-free Git worktree commander for macOS and Linux."""

import argparse
import curses
import locale
import os
import queue
import shlex
import signal
import subprocess
import sys
import textwrap
import threading
import time
from dataclasses import dataclass, replace
from typing import List, Optional


class Error(Exception):
    pass


class Cancelled(Error):
    pass


def canonical(path):
    return os.path.realpath(path)


def contains(parent, child):
    return os.path.commonpath([canonical(parent), canonical(child)]) == canonical(parent)


def visible(value):
    """Do not let filenames or Git output inject terminal controls or fake rows."""
    return "".join(c if c.isprintable() else c.encode("unicode_escape").decode("ascii")
                   for c in str(value))


def command_text(command):
    return visible(" ".join(shlex.quote(arg) for arg in command))


def git_environment(interactive=False):
    env = os.environ.copy()
    # These override -C or cause discovery to select another repository/index.
    for key in ("GIT_DIR", "GIT_WORK_TREE", "GIT_COMMON_DIR", "GIT_INDEX_FILE",
                "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES",
                "GIT_NAMESPACE", "GIT_PREFIX", "GIT_CEILING_DIRECTORIES",
                "GIT_DISCOVERY_ACROSS_FILESYSTEM", "GIT_IMPLICIT_WORK_TREE",
                "GIT_CONFIG_PARAMETERS", "GIT_CONFIG_COUNT"):
        env.pop(key, None)
    for key in list(env):
        if key.startswith(("GIT_CONFIG_KEY_", "GIT_CONFIG_VALUE_")):
            env.pop(key)
    if not interactive:
        env.update(GIT_OPTIONAL_LOCKS="0", GIT_TERMINAL_PROMPT="0", LC_ALL="C")
    return env


@dataclass
class Worktree:
    path: str
    head: str = ""
    branch: str = ""
    bare: bool = False
    locked: Optional[str] = None
    prunable: Optional[str] = None
    current: bool = False
    main: bool = False
    dirty: Optional[bool] = None
    error: str = ""
    missing: Optional[bool] = None

    @property
    def label(self):
        if self.bare:
            return "(bare repository)"
        return self.branch or "detached " + self.head[:10]

    @property
    def state(self):
        flags = []
        if self.missing:
            flags.append("missing")
        if self.prunable is not None:
            flags.append("prunable")
        if self.locked is not None:
            flags.append("locked")
        if self.error:
            flags.append("error")
        elif self.dirty is not None:
            flags.append("dirty" if self.dirty else "clean")
        elif not self.bare and not self.missing:
            flags.append("pending")
        return ", ".join(flags) or "-"


def parse_worktrees(data):
    result = []
    for record in data.split(b"\0\0"):
        fields = {}
        for item in record.split(b"\0"):
            if item:
                key, _, value = item.partition(b" ")
                fields[key] = os.fsdecode(value)
        if b"worktree" not in fields:
            continue
        branch = fields.get(b"branch", "")
        if branch.startswith("refs/heads/"):
            branch = branch[len("refs/heads/"):]
        result.append(Worktree(
            fields[b"worktree"], fields.get(b"HEAD", ""), branch,
            b"bare" in fields, fields.get(b"locked"), fields.get(b"prunable"),
            main=not result))
    return result


@dataclass
class Action:
    kind: str
    command: List[str]
    preview: str
    token: str
    worktree: Optional[Worktree]


class Repo:
    def __init__(self, path="."):
        self.anchor = canonical(path)
        self.cwd = canonical(os.getcwd())
        self.common = self.git_path("--git-common-dir", self.anchor)
        info = os.stat(self.common)
        self.common_identity = (info.st_dev, info.st_ino)
        self.current = None
        if self.run("rev-parse", "--is-bare-repository").strip() != b"true":
            self.current = self.git_path("--show-toplevel", self.anchor)
            # A clean/reset can delete the subdirectory used to launch us.
            self.anchor = self.current

    def command(self, *args, path=None):
        return ["git", "-C", path or self.anchor, *args]

    def run(self, *args, path=None, cancel=None):
        command = self.command(*args, path=path)
        if cancel is not None and cancel.is_set():
            raise Cancelled("Scan cancelled.")
        try:
            with subprocess.Popen(command, env=git_environment(), stdout=subprocess.PIPE,
                                  stderr=subprocess.PIPE, stdin=subprocess.DEVNULL,
                                  start_new_session=cancel is not None) as process:
                while True:
                    try:
                        output, errors = process.communicate(timeout=0.1 if cancel is not None else None)
                        break
                    except subprocess.TimeoutExpired:
                        if cancel.is_set():
                            # Status can spawn submodule helpers. Stop only this scan's
                            # process group, and reap it before leaving the worker.
                            try:
                                os.killpg(process.pid, signal.SIGKILL)
                            except ProcessLookupError:
                                pass
                            process.communicate()
                            raise Cancelled("Scan cancelled.")
        except OSError as exc:
            raise Error(str(exc)) from exc
        if process.returncode:
            raise Error(command_text(command) + "\n" +
                        os.fsdecode(errors or output).strip())
        return output

    def git_path(self, option, path, cancel=None):
        # Remove only Git's output delimiter, preserving newlines in the path.
        value = os.fsdecode(self.run("rev-parse", "--path-format=absolute", option,
                                     path=path, cancel=cancel)).removesuffix("\n")
        return canonical(value)

    def worktrees(self, check_status=True, cancel=None):
        trees = parse_worktrees(self.run("worktree", "list", "--porcelain", "-z",
                                        "--expire", "now", cancel=cancel))
        for wt in trees:
            wt.current = self.current is not None and canonical(wt.path) == self.current
        if check_status:
            trees = [self.inspect(wt, cancel=cancel) for wt in trees]
        return trees

    def inspect(self, wt, cancel=None):
        if wt.bare:
            return wt
        if not os.path.isdir(wt.path):
            return replace(wt, missing=True, dirty=None, error="")
        wt = replace(wt, missing=False)
        try:
            self.check_identity(wt, cancel=cancel)
            dirty = bool(self.run("status", "--porcelain=v1", "-z",
                                  "--untracked-files=normal", "--ignore-submodules=none",
                                  path=wt.path, cancel=cancel))
            return replace(wt, dirty=dirty, error="")
        except Cancelled:
            raise
        except Error as exc:
            return replace(wt, dirty=None, error=str(exc))

    def check_identity(self, wt, cancel=None):
        if wt.bare or not os.path.isdir(wt.path):
            raise Error("Select an existing, non-bare worktree.")
        if (self.git_path("--show-toplevel", wt.path, cancel=cancel) != canonical(wt.path) or
                self.git_path("--git-common-dir", wt.path, cancel=cancel) != self.common):
            raise Error("Worktree path no longer identifies this repository: " + visible(wt.path))

    def check_repository(self):
        info = os.stat(self.common)
        if ((info.st_dev, info.st_ino) != self.common_identity or
                self.git_path("--git-common-dir", self.anchor) != self.common):
            raise Error("Repository changed since startup; restart the browser.")

    def validate(self, wt, removal=False):
        self.check_repository()
        fresh = next((item for item in self.worktrees(check_status=False) if item.path == wt.path), None)
        if fresh is None:
            raise Error("Worktree is no longer registered; refresh the list.")
        self.check_identity(fresh)
        if (fresh.head, fresh.branch) != (wt.head, wt.branch):
            raise Error("Worktree HEAD or branch changed; refresh and review again.")
        if removal:
            if fresh.main or fresh.current or contains(fresh.path, self.cwd):
                raise Error("Removal of the main or current worktree is protected.")
            if fresh.locked is not None:
                raise Error("Worktree is locked: " + visible(fresh.locked))
            fresh = self.inspect(fresh)
            if fresh.dirty or fresh.error:
                raise Error("Worktree is dirty or unreadable. Review its status first; removal uses no force.")
        return fresh

    def status(self, wt, ignored=False):
        self.check_identity(wt)
        args = ["status", "--short", "--untracked-files=all", "--ignore-submodules=none"]
        if ignored:
            args.append("--ignored")
        return os.fsdecode(self.run(*args, path=wt.path)) or "(clean)\n"

    def plan(self, wt, kind):
        if kind == "prune":
            self.check_repository()
            command = self.command("worktree", "prune", "--verbose", "--expire", "now")
            preview_command = self.command("worktree", "prune", "--dry-run", "--verbose", "--expire", "now")
            # git prune writes its report to stderr on some versions.
            preview = self.report(preview_command)
            return Action(kind, command,
                          "Repository-wide metadata cleanup (all missing, unlocked worktrees).\n"
                          "Mounted/offline worktrees should be locked before pruning.\n"
                          "No worktree files or branches are deleted.\n\n" +
                          command_text(preview_command) + "\n" + preview,
                          "PRUNE", None)
        self.validate(wt, removal=kind == "remove")
        if kind == "remove":
            command = self.command("worktree", "remove", "--", wt.path)
            preview = ("Deletes the entire selected directory, INCLUDING ignored files.\n"
                       "No --force; Git will refuse tracked/untracked changes. Branch is kept.\n\n" +
                       self.status(wt, ignored=True))
            token = "REMOVE"
        elif kind == "reset":
            command = self.command("-c", "submodule.recurse=false", "reset", "--hard", "HEAD", path=wt.path)
            preview = ("Discards ALL staged and unstaged tracked changes in this worktree.\n"
                       "Untracked files/directories obstructing tracked files may also be deleted.\n"
                       "Submodule worktrees are not reset.\n\n" + self.status(wt))
            token = "RESET"
        elif kind in ("clean", "clean-dirs"):
            directories = kind == "clean-dirs"
            command = self.command("clean", "-fd" if directories else "-f", path=wt.path)
            preview_command = self.command("clean", "-nd" if directories else "-n", path=wt.path)
            preview = ("Permanently deletes untracked " + ("files and directories" if directories else "files") +
                       ".\nIgnored files and nested Git repositories are kept.\n\n" +
                       command_text(preview_command) + "\n" + self.report(preview_command))
            token = "CLEAN"
        else:
            raise Error("Unknown action: " + kind)
        return Action(kind, command, preview, token, wt)

    def report(self, command):
        result = subprocess.run(command, env=git_environment(), stdout=subprocess.PIPE,
                                stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
        if result.returncode:
            raise Error(command_text(command) + "\n" + os.fsdecode(result.stdout))
        return os.fsdecode(result.stdout) or "(no candidates)\n"

    def execute(self, action, confirmation):
        if confirmation != action.token:
            raise Error("Cancelled: confirmation did not match.")
        if action.worktree is not None:
            self.validate(action.worktree, removal=action.kind == "remove")
        # Recompute previews after the prompt; refuse changed clean/prune candidates,
        # status or HEAD so a stale confirmation cannot silently approve new data.
        fresh = self.plan(action.worktree, action.kind)
        if fresh.command != action.command or fresh.preview != action.preview:
            raise Error("Worktree or preview changed during confirmation. Review the action again.")
        return self.report(action.command)


class WorktreeScan:
    """Collect read-only data off the curses thread; publish immutable snapshots."""

    def __init__(self, repo):
        self.repo = repo
        self.updates = queue.Queue()
        self.cancel = threading.Event()
        self.thread = threading.Thread(target=self.run, daemon=True)
        self.thread.start()

    def run(self):
        try:
            trees = self.repo.worktrees(check_status=False, cancel=self.cancel)
            self.updates.put(("list", trees))
            pending = [wt for wt in trees if not wt.bare]
            for i, wt in enumerate(pending, 1):
                if self.cancel.is_set():
                    break
                self.updates.put(("progress", (i, len(pending), wt.path)))
                self.updates.put(("status", self.repo.inspect(wt, cancel=self.cancel)))
        except Cancelled:
            pass
        except (Error, OSError) as exc:
            self.updates.put(("error", str(exc)))
        finally:
            self.updates.put(("done", None))

    def close(self, wait=True, timeout=1):
        self.cancel.set()
        if wait:
            self.thread.join(timeout=timeout)


HELP = """Git worktree commander

Up/Down or j/k    Select worktree (Home/End, PgUp/PgDn also work)
Enter            Open shell in selected worktree; gwt changes caller's directory
o                Open a subshell in selected worktree; exit returns here
s / F3           Full short status (including untracked files)
r / F2           Refresh registered worktrees and dirty status
d / F8           Remove clean linked worktree (no force; keeps its branch)
R                git reset --hard HEAD (staged + unstaged tracked changes)
n / N            Preview git clean -n / git clean -nd
c / C            git clean -f / git clean -fd (always previews first)
p / P            Preview / execute repo-wide prune --expire now
? / h / F1       This help
q / Esc / F10    Quit, or close a preview

The list loads first; dirty statuses fill in as background checks finish.
A spinner shows the current check. Navigation and quitting remain available.

Destructive actions show the affected path, exact command and preview. Type
the displayed uppercase word and press Enter to confirm; Esc cancels.
Commands run at the selected worktree root. Clean preserves ignored files and
nested Git repos. Remove also deletes
ignored files. Main/current worktrees cannot be removed. Locked worktrees are
not removed or pruned. Git repository-targeting environment overrides are ignored.

Requirements: Python 3.9+ with curses, Git supporting worktree list --porcelain -z.
"""


class Browser:
    def __init__(self, screen, repo, cd_file=None):
        self.screen, self.repo, self.cd_file = screen, repo, cd_file
        self.trees = []
        self.index = 0
        self.notice = "Loading registered worktrees... (q quits)"
        self.result = None
        self.scan = None
        self.scans = []
        self.loading = False
        self.scan_error = ""
        screen.keypad(True)
        curses.curs_set(0)
        if curses.has_colors():
            curses.start_color()
            try:
                curses.use_default_colors()
            except curses.error:
                pass
        screen.bkgd(" ", curses.A_NORMAL)
        self.draw()
        self.refresh()

    def put(self, y, x, value, width=None, attr=0):
        height, columns = self.screen.getmaxyx()
        if 0 <= y < height and 0 <= x < columns:
            try:
                self.screen.addnstr(y, x, visible(value), max(0, min(width or columns, columns - x - 1)), attr)
            except (curses.error, UnicodeError):
                pass

    def refresh(self):
        if self.scan is not None:
            self.scan.close(wait=False)
        self.scans = [scan for scan in self.scans if scan.thread.is_alive()]
        self.loading = True
        self.scan_error = ""
        self.notice = "Loading registered worktrees... (q quits)"
        self.scan = WorktreeScan(self.repo)
        self.scans.append(self.scan)

    def poll_scan(self):
        while self.scan is not None:
            try:
                kind, value = self.scan.updates.get_nowait()
            except queue.Empty:
                break
            if kind == "list":
                path = self.trees[self.index].path if self.trees else None
                self.trees = value
                self.index = next((i for i, wt in enumerate(self.trees) if wt.path == path),
                                  min(self.index, max(0, len(self.trees) - 1)))
            elif kind == "progress":
                i, total, path = value
                self.notice = "Checking status {}/{}: {}".format(i, total, visible(path))
            elif kind == "status":
                self.trees = [value if wt.path == value.path else wt for wt in self.trees]
            elif kind == "error":
                self.scan_error = value
            elif kind == "done":
                self.loading = False
                self.notice = ("Scan failed: " + visible(self.scan_error) if self.scan_error else
                               "F1 Help  |  * current worktree  |  r refresh")

    def draw(self):
        screen = self.screen
        screen.erase()
        height, width = screen.getmaxyx()
        if height < 12 or width < 64:
            self.put(0, 0, "Resize terminal to at least 64x12; q quits.")
            screen.refresh()
            return
        self.put(0, 1, " Git Worktree Commander ", attr=curses.A_BOLD)
        self.put(1, 1, self.repo.anchor)
        split = width * 3 // 5
        self.put(3, 1, "  BRANCH / HEAD [STATE] / PATH", split - 2, curses.A_BOLD)
        page = max(1, (height - 8) // 2)
        start = max(0, self.index - page + 1)
        for offset, wt in enumerate(self.trees[start:start + page]):
            row = 4 + offset * 2
            selected = start + offset == self.index
            attr = curses.A_REVERSE if selected else curses.A_NORMAL
            label = visible(wt.label)[:max(8, split - 25)]
            line = "{} {} [{}]".format("*" if wt.current else " ", label, wt.state)
            self.put(row, 1, line.ljust(split - 2), split - 2, attr)
            self.put(row + 1, 1, ("  " + visible(wt.path)).ljust(split - 2), split - 2, attr)
        if self.trees:
            wt = self.trees[self.index]
            details = ["Selected worktree", "", wt.path, "", wt.label, wt.head,
                       "State: " + wt.state]
            if wt.main:
                details.append("Main worktree (protected)")
            if wt.current:
                details.append("Current worktree (protected)")
            if wt.locked is not None:
                details.append("Lock: " + wt.locked)
            if wt.prunable is not None:
                details.append("Prunable: " + wt.prunable)
            if wt.error:
                details.append(wt.error)
            lines = []
            for line in details:
                lines.extend(textwrap.wrap(visible(line), max(1, width - split - 3)) or [""])
            for row, line in enumerate(lines[:height - 7], 3):
                self.put(row, split + 1, line)
        elif self.loading:
            self.put(5, 2, "Loading worktrees... You can press q to quit.")
        if self.scan_error:
            for row, line in enumerate(textwrap.wrap(visible(self.scan_error), max(1, split - 4))[:3], 5):
                self.put(row, 2, line, split - 3)
        spinner = "|/-\\"[int(time.monotonic() * 8) % 4] + " " if self.loading else ""
        self.put(height - 3, 1, spinner + self.notice)
        self.put(height - 2, 1, "F1 Help  F2 Refresh  F3 Status  F8 Remove  Enter Open  F10 Quit", attr=curses.A_BOLD)
        self.put(height - 1, 1, "R Reset  n/N Preview clean  c/C Clean  p/P Prune  o Shell")
        screen.refresh()

    def dialog(self, title, content, token=None):
        self.screen.timeout(-1)
        lines = []
        offset, typed = 0, ""
        for line in content.splitlines():
            lines.append(visible(line))
        # Drain the action key's repeat/paste buffer before any confirmation.
        if token:
            curses.flushinp()
        while True:
            self.screen.erase()
            height, width = self.screen.getmaxyx()
            wrapped = []
            for line in lines:
                wrapped.extend(textwrap.wrap(line, max(1, width - 4), replace_whitespace=False) or [""])
            page = max(1, height - 5)
            offset = min(offset, max(0, len(wrapped) - page))
            self.put(0, 1, title, attr=curses.A_BOLD)
            for row, line in enumerate(wrapped[offset:offset + page], 2):
                self.put(row, 1, line)
            self.put(height - 2, 1, "Up/Down/PgUp/PgDn scroll | Esc cancels" if token else "Up/Down/PgUp/PgDn scroll | q/Esc/Enter closes")
            prompt = "Type {} then Enter: {}".format(token, typed) if token else "{}/{} lines".format(min(offset + page, len(wrapped)), len(wrapped))
            self.put(height - 1, 1, prompt, attr=curses.A_BOLD)
            self.screen.refresh()
            key = self.screen.getch()
            if key == 27:
                return False
            if key in (curses.KEY_DOWN, curses.KEY_NPAGE):
                offset += 1 if key == curses.KEY_DOWN else page
            elif key in (curses.KEY_UP, curses.KEY_PPAGE):
                offset = max(0, offset - (1 if key == curses.KEY_UP else page))
            elif token and key in (curses.KEY_BACKSPACE, 127, 8):
                typed = typed[:-1]
            elif key in (10, 13, curses.KEY_ENTER):
                if not token:
                    return False
                if typed == token:
                    return True
                typed = ""
            elif not token and key in (ord("q"), ord("Q")):
                return False
            elif token and 32 <= key <= 126:
                typed = (typed + chr(key))[:32]

    def destructive(self, wt, kind, preview_only=False):
        action = self.repo.plan(wt, kind)
        target = wt.path if wt is not None else self.repo.common
        body = "Affected {}: {}\n\nCommand: {}\n\n{}".format(
            "worktree" if wt else "repository", visible(target), command_text(action.command), action.preview)
        if self.dialog("Preview: " + kind if preview_only else "Confirm: " + kind,
                       body, None if preview_only else action.token):
            output = self.repo.execute(action, action.token)
            self.dialog("Completed: " + kind, command_text(action.command) + "\n\n" + output)
            self.refresh()

    def open_shell(self, wt):
        self.repo.validate(wt)
        curses.def_prog_mode()
        curses.endwin()
        try:
            shell = os.environ.get("SHELL") or "/bin/bash"
            print("Worktree: " + visible(wt.path) + "\nExit the shell to return to git-wt.")
            subprocess.run([shell], cwd=wt.path, env=git_environment(interactive=True))
        finally:
            curses.reset_prog_mode()
            self.screen.clear()
        self.refresh()

    def run(self):
        try:
            return self.browse()
        finally:
            # Also reap scans retired by repeated refreshes before exiting.
            for scan in self.scans:
                scan.close(wait=False)
            deadline = time.monotonic() + 1
            for scan in self.scans:
                scan.close(timeout=max(0, deadline - time.monotonic()))

    def browse(self):
        while True:
            self.poll_scan()
            self.draw()
            self.screen.timeout(100 if self.loading else -1)
            key = self.screen.getch()
            if key in (ord("q"), 27, curses.KEY_F10):
                return self.result
            try:
                if key in (curses.KEY_DOWN, ord("j")):
                    self.index = max(0, min(len(self.trees) - 1, self.index + 1))
                elif key in (curses.KEY_UP, ord("k")):
                    self.index = max(0, self.index - 1)
                elif key in (curses.KEY_HOME, curses.KEY_END, curses.KEY_NPAGE, curses.KEY_PPAGE):
                    step = max(1, (self.screen.getmaxyx()[0] - 8) // 2)
                    self.index = max(0, {curses.KEY_HOME: 0, curses.KEY_END: len(self.trees) - 1,
                                  curses.KEY_NPAGE: min(len(self.trees) - 1, self.index + step),
                                  curses.KEY_PPAGE: max(0, self.index - step)}[key])
                elif key in (ord("?"), ord("h"), curses.KEY_F1):
                    self.dialog("Help", HELP)
                elif key in (ord("r"), curses.KEY_F2):
                    self.refresh()
                elif key in (ord("p"), ord("P")):
                    self.destructive(None, "prune", preview_only=key == ord("p"))
                elif self.trees:
                    wt = self.trees[self.index]
                    if key in (10, 13, curses.KEY_ENTER) and self.cd_file:
                        self.repo.validate(wt)
                        return wt.path
                    if key in (10, 13, curses.KEY_ENTER, ord("o")):
                        self.open_shell(wt)
                    elif key in (ord("s"), curses.KEY_F3):
                        self.dialog("Status: " + visible(wt.path), self.repo.status(wt))
                    elif key in (ord("d"), curses.KEY_F8, ord("R"), ord("c"), ord("C"), ord("n"), ord("N")):
                        kind = {ord("R"): "reset", ord("c"): "clean", ord("C"): "clean-dirs",
                                ord("n"): "clean", ord("N"): "clean-dirs"}.get(key, "remove")
                        self.destructive(wt, kind, preview_only=key in (ord("n"), ord("N")))
            except (Error, OSError) as exc:
                self.dialog("Action stopped", str(exc))


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter,
                                     epilog=HELP)
    parser.add_argument("directory", nargs="?", default=".", help="repository directory (default: current directory)")
    parser.add_argument("--cd-file", metavar="FILE", help="write selected raw path + NUL for the gwt shell helper")
    args = parser.parse_args()
    try:
        if not sys.stdin.isatty() or not sys.stdout.isatty():
            raise Error("An interactive terminal is required. Use gwt to change the calling shell's directory.")
        locale.setlocale(locale.LC_ALL, "")
        repo = Repo(args.directory)
        result = curses.wrapper(lambda screen: Browser(screen, repo, args.cd_file).run())
        if result is not None and args.cd_file:
            with open(args.cd_file, "wb") as output:
                output.write(os.fsencode(result) + b"\0")
        return 0
    except (Error, OSError, curses.error) as exc:
        print("git-wt: " + visible(str(exc)), file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
